            "properties": {
                "b_format": {
                    "type": "string"
                },
                "category": {
                    "type": "string"
                },
                "filesize": {
                    "type": "integer"
                },
                "price": {
                    "type": "number"
                },
                "prod_year": {
                    "type": "integer"
                },
                "pub_id": {
                    "type": "integer"
                },
                "quantity": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                }
